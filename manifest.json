{
  "manifest_version": 3,
  "name": "Gomtu Everywhere",
  "version": "1.0.0",
  "description": "Tampilkan skor Gomtu di profil Twitter/X seperti Ethos.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://gomtu.xyz/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.twitter.com/*",
        "https://twitter.com/*",
        "https://x.com/*",
        "https://*.x.com/*"
      ],
      "js": ["content_script.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "Gomtu Everywhere Settings",
    "default_popup": "popup.html"
  }
}
